@model List<K2Portal.Models.K2TaskItem>
@{
    ViewData["Title"] = "Home";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <h4 class="mb-0">📋 Worklist</h4>
                <span class="badge bg-primary">@Model.Count</span>
            </div>
            <input type="text" id="searchInput" class="form-control w-25" placeholder="🔍 Search task">
        </div>

        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0" id="taskTable">
                <thead class="table-light">
                    <tr>
                        <th style="width:540px;">Folio</th>
                        <th>Workflow</th>
                        <th>Activity</th>
                        <th style="width:180px;">Submit Date</th>
                        @* <th style="width:120px;">Serial</th> *@
                        <th style="width:120px;">Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="max-width:540px; white-space:nowrap; overflow:hidden;">
                                <a href="@item.FormURL" target="_blank" class="text-decoration-none">
                                    @item.WorkflowInstanceFolio
                                </a>
                            </td>

                            <td>
                                <span class="badge bg-info text-dark">
                                    @item.WorkflowDisplayName
                                </span>
                            </td>

                            <td>
                                @item.ActivityName
                            </td>

                            <td>
                                <small class="text-muted">
                                    @item.TaskStartDate?.ToString("dd MMM yyyy HH:mm")
                                </small>
                            </td>

                            <td>
                                @* <code>@item.SerialNumber</code> *@
                                <code>@item.Status</code>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <nav>
                <ul class="pagination mb-0" id="pagination"></ul>
            </nav>

            <div>
                <small class="text-muted">Go to page</small>
                <input type="number" id="gotoPage" min="1" style="width:70px" class="form-control d-inline-block form-control-sm">
            </div>
        </div>
    </div>
</div>

<script>

const rowsPerPage = 10;
const rows = Array.from(document.querySelectorAll("#taskTable tbody tr"));
const pagination = document.getElementById("pagination");
const gotoPageInput = document.getElementById("gotoPage");
const searchInput = document.getElementById("searchInput");

let filteredRows = [...rows];
let currentPage = 1;

function displayPage(page){
    currentPage = page;
    rows.forEach(row => row.style.display = "none");
    const start = (page - 1) * rowsPerPage;
    const end = start + rowsPerPage;
    filteredRows.slice(start, end).forEach(row => row.style.display = "");
    renderPagination();
}

function renderPagination(){
    pagination.innerHTML = "";
    const pageCount = Math.ceil(filteredRows.length / rowsPerPage);
    const maxVisible = 5;
    let start = Math.max(1, currentPage - 2);
    let end = Math.min(pageCount, start + maxVisible - 1);
    if (end - start < maxVisible - 1) start = Math.max(1, end - maxVisible + 1);

    addPageItem("«", currentPage - 1, currentPage === 1);

    if (start > 1){
        addPageItem(1, 1);
        if (start > 2) addDots();
    }

    for (let i = start; i <= end; i++) addPageItem(i, i, false, i === currentPage);

    if (end < pageCount){
        if (end < pageCount - 1) addDots();
        addPageItem(pageCount, pageCount);
    }

    addPageItem("»", currentPage + 1, currentPage === pageCount);
}

function addPageItem(text, page, disabled = false, active = false){
    const li = document.createElement("li");
    li.className = "page-item";
    if (disabled) li.classList.add("disabled");
    if (active) li.classList.add("active");

    const a = document.createElement("a");
    a.className = "page-link";
    a.innerText = text;
    a.addEventListener("click", () => { if (!disabled) displayPage(page); });

    li.appendChild(a);
    pagination.appendChild(li);
}

function addDots(){
    const li = document.createElement("li");
    li.className = "page-item disabled";
    const span = document.createElement("span");
    span.className = "page-link";
    span.innerText = "...";
    li.appendChild(span);
    pagination.appendChild(li);
}

gotoPageInput.addEventListener("change", () => {
    const pageCount = Math.ceil(filteredRows.length / rowsPerPage);
    let page = parseInt(gotoPageInput.value);
    if (page >= 1 && page <= pageCount) displayPage(page);
});

// 🔎 SEARCH
searchInput.addEventListener("keyup", function(){
    const keyword = this.value.toLowerCase();
    filteredRows = rows.filter(row => row.innerText.toLowerCase().includes(keyword));
    displayPage(1);
});

displayPage(1);

</script>